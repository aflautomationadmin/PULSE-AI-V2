OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM router model id (LiteLLM format):
# - OpenAI example: openai/gpt-4.1-mini
# - Claude example: anthropic/claude-3-5-sonnet-latest
LLM_MODEL=openai/gpt-4.1-mini
LLM_TIMEOUT_SECONDS=45
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=30

DB_SERVER=t5fulvvcjsjehnrpedrb4vbtli-crzekx4zfiqutls4y4njjiwi3y.datawarehouse.fabric.microsoft.com
DB_DATABASE=Dataverse_Prod
DB_USERNAME=your-username
DB_PASSWORD=your-password
DB_DRIVER={ODBC Driver 18 for SQL Server}

SCHEMA_CACHE_PATH=.cache/schema_cache.json
SCHEMA_CACHE_TTL_SECONDS=3600
MAX_RESULT_ROWS=200
PREVIEW_ROWS=10
BUSINESS_CONTEXT_PATH=business_context.json
MEMORY_MAX_TURNS=12
MEMORY_STORE_PATH=.cache/memory_threads.json
MEMORY_DEFAULT_THREAD=default
MEMORY_AUTO_CREATE_THREAD=true
SQL_CACHE_ENABLED=true
SQL_CACHE_PATH=.cache/sql_query_cache.sqlite3
SQL_CACHE_SEMANTIC_ENABLED=true
SQL_CACHE_SIMILARITY_THRESHOLD=0.92
SQL_DEBUG_MAX_RETRIES=1
ENTITY_SEARCH_ENABLED=true
ENTITY_STATE_CACHE_PATH=.cache/state_entity_index.sqlite3
ENTITY_STATE_CACHE_TTL_SECONDS=86400
ENTITY_STATE_SIMILARITY_THRESHOLD=0.86
VISUALIZATION_ENABLED=true
CHART_THEME_PATH=chart_theme.json
CHART_OUTPUT_DIR=.cache/charts
CHART_MAX_POINTS=50
LITELLM_LOCAL_MODEL_COST_MAP=true

# MongoDB memory backend (leave MONGO_URI blank to use local JSON memory instead)
# Local:  MONGO_URI=mongodb://localhost:27017
# Atlas:  MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_da_agents
MONGO_COLLECTION=conversation_threads
MONGO_USER_ID=anonymous

# Azure AD — Microsoft login (JWT validation on backend)
# Leave blank to disable auth (all requests treated as "anonymous")
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Admin portal — emails that can open the admin portal (comma-separated).
# These are permanent super-admins and cannot be removed from the UI.
ADMIN_EMAILS=mohit.lokhande@arvindfashions.com,radhakishan.thakur@arvindfashions.com

# Optional: set this if your network uses a custom root CA
SSL_CERT_FILE=C:\\certs\\corp-root-ca.pem
